<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) ignores android:allowBackup for device-to-device
  transfers and uses this file instead, so allowBackup="false" in the
  manifest only covers API 26-30. Excluding every domain here opts out of
  both cloud backup and D2D transfer on 31+.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
