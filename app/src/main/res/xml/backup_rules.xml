<?xml version="1.0" encoding="utf-8"?>
<!--
  Pre-Android 12 (API 26-30) counterpart to data_extraction_rules.xml.
  Redundant while allowBackup="false", but lint requires it alongside
  dataExtractionRules when minSdk < 31.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
